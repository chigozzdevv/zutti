// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {ZiskVerifier} from "../src/ZiskVerifier.sol";

contract ZiskProofTest {
    ZiskVerifier private verifier;
    bytes32 private constant PROGRAM = __PROGRAM__;
    bytes32 private constant ROOT = __ROOT__;

    function setUp() public {
        verifier = new ZiskVerifier();
    }

    function inputs() private pure returns (bytes memory, bytes memory) {
        return (hex"__PUBLICS__", hex"__PROOF__");
    }

    function succeeds(bytes32 program, bytes32 root, bytes memory values, bytes memory proof)
        private view returns (bool)
    {
        (bool ok,) = address(verifier).staticcall(
            abi.encodeCall(verifier.verifySnarkProof, (program, root, values, proof))
        );
        return ok;
    }

    function testValidProof() public view {
        (bytes memory values, bytes memory proof) = inputs();
        require(verifier.getRootCVadcopFinal() == ROOT, "wrong pinned setup");
        require(succeeds(PROGRAM, ROOT, values, proof), "valid proof rejected");
    }

    function testChangedPublicValuesRejected() public view {
        (bytes memory values, bytes memory proof) = inputs();
        values[0] ^= bytes1(uint8(1));
        require(!succeeds(PROGRAM, ROOT, values, proof), "changed output accepted");
    }

    function testChangedProgramRejected() public view {
        (bytes memory values, bytes memory proof) = inputs();
        require(!succeeds(bytes32(uint256(PROGRAM) ^ 1), ROOT, values, proof), "changed program accepted");
    }

    function testChangedSetupRejected() public view {
        (bytes memory values, bytes memory proof) = inputs();
        require(!succeeds(PROGRAM, bytes32(uint256(ROOT) ^ 1), values, proof), "changed setup accepted");
    }

    function testChangedProofRejected() public view {
        (bytes memory values, bytes memory proof) = inputs();
        proof[0] ^= bytes1(uint8(1));
        require(!succeeds(PROGRAM, ROOT, values, proof), "changed proof accepted");
    }
}
