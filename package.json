{
  "name": "zutti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-client.mjs",
    "build:client": "pnpm build:ts && pnpm --filter @zutti/client build",
    "start:client": "node server/dist/ui-server.js",
    "setup": "bash scripts/setup.sh",
    "build": "bash scripts/build.sh",
    "lint": "bash scripts/lint.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "bash scripts/test.sh",
    "test:proofs": "bash scripts/test-proofs.sh",
    "boundless": "bash scripts/boundless.sh",
    "test:boundless": "bash scripts/test-boundless.sh",
    "build:ts": "tsc -b",
    "typecheck:ts": "tsc -b --pretty false",
    "test:ts": "bash scripts/test-typescript.sh",
    "lint:ts": "eslint packages server client/src client/vite.config.ts --max-warnings=0",
    "typecheck:client": "pnpm --filter @zutti/client typecheck",
    "codegen": "node --experimental-strip-types packages/bindings/codegen.ts",
    "build:wallet": "bash scripts/build-wallet.sh",
    "typecheck:wallet": "tsc -p packages/snap/tsconfig.json",
    "test:wallet": "node --experimental-strip-types --test packages/snap/test/*.test.mjs packages/snap/integration/*.test.mjs",
    "serve:wallet": "node packages/snap/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "typescript-eslint": "8.72.0"
  }
}
